# Database Configuration
POSTGRES_USER=ytsession
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=ytsession
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=3000
NODE_ENV=production

# Frontend Configuration
FRONTEND_PORT=5173

# API URL (Optional - Frontend auto-detects based on browser URL)
# Only set this if you need to override the default behavior
# Examples:
#   Local: http://localhost:3000
#   Remote: http://10.10.40.91:3000
#   Production: https://api.yourdomain.com
# API_URL=http://localhost:3000

APP_NAME=YT Insight

# AI Configuration
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# Leave as 'your_openai_api_key_here' to run without AI features
AI_MODEL=gpt-4o
AI_API_KEY=your_openai_api_key_here
